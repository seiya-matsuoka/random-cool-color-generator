{
  "name": "random-cool-color-generator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage",
    "storybook": "node scripts/storybook.mjs dev --host 127.0.0.1 --port 6006 --exact-port --no-open --no-version-updates --disable-telemetry",
    "build-storybook": "node scripts/storybook.mjs build --disable-telemetry",
    "verify": "npm run check && npm run build && npm run build-storybook",
    "e2e:install": "node scripts/playwright.mjs install chromium",
    "test:e2e:production": "node scripts/playwright.mjs test --config playwright.config.ts",
    "test:browser-lifecycle": "node scripts/playwright.mjs test --config playwright.lifecycle.config.ts",
    "test:e2e": "npm run test:e2e:production && npm run test:browser-lifecycle",
    "test:e2e:ui": "node scripts/playwright.mjs test --config playwright.config.ts --ui"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "storybook": "10.6.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
